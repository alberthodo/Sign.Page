# Cloud development (private SignOffWebApp repo)
SIGNOFF_EDITION=cloud

# Public app URL (review links, auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Sign.page

# Open-source mirror (public)
NEXT_PUBLIC_GITHUB_REPO_URL=https://github.com/alberthodo/Sign.Page

# Supabase (required — https://supabase.com/dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only: service_role key (recommended for review fallbacks; never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=

# Onboarding dev: reopen flow from /onboarding/getting-started (banner only when false hides it)
# SIGNOFF_ONBOARDING_ALWAYS_NEW=true

# Cloud billing (optional until Stripe is wired)
# SIGNOFF_CLOUD_MAX_PROJECTS=10
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# RESEND_API_KEY=

# Google Analytics (cloud landing only — set in Vercel Production)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-2Q6JBM08MT
